# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Application credentials (server-only; hash the passwords, do not store plaintext) ---
# IMPORTANT: Next.js's built-in env loader expands $VAR / ${VAR} references,
# and bcrypt hashes contain literal $ characters (e.g. $2b$12$...) that look
# like variable references to it. Escape every $ as \$ here or the hash gets
# silently mangled (this does NOT apply to the SUPABASE_DB_* vars below,
# which are read only by scripts/*.mjs via plain `dotenv`, not Next's loader
# — leave those unescaped).
ADMIN_EMAIL=admin@neurax.dev
ADMIN_PASSWORD_HASH=<bcrypt-hash-with-$-escaped-as-\$>
PARTICIPANT_PASSWORD_HASH=<bcrypt-hash-with-$-escaped-as-\$>

# --- Session / QR signing secrets (high-entropy random hex, 32+ bytes) ---
SESSION_SECRET=<random-hex-secret>
QR_SIGNING_SECRET=<random-hex-secret>

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=<supabase-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# Direct Postgres connection, used only by migration scripts (never imported by the app).
SUPABASE_DB_HOST=<db-host>
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<db-password>
SUPABASE_DB_NAME=postgres
