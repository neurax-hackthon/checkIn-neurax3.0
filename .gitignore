# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is a template with no secrets and is committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local state
.claude/

# participant/roster data dumps — never commit real names/emails/phone
# numbers to this public repo. Import spreadsheets via the admin UI's
# /admin/import flow (or a one-off script reading from outside the repo),
# not by dropping the file in the project directory.
*.xlsx
*.xls
*.csv
